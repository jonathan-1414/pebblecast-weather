{
  "name": "pebblecastweather",
  "author": "Constantin Matheis",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "Pebblecast Weather",
    "uuid": "28e422b7-5ae0-4bb7-9bb6-770efe9b0b6d",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "diorite",
      "emery",
      "flint"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "location",
      "configurable"
    ],
    "messageKeys": [
      "REQUEST_WEATHER",
      "TEMP_COUNT",
      "TEMP_DATA",
      "HOUR_DATA",
      "WEATHER_CODE_DATA",
      "TODAY_TEMP_MAX",
      "TODAY_TEMP_MIN",
      "TOMORROW_TEMP_MAX",
      "TOMORROW_WEATHER_CODE",
      "CITY_NAME",
      "ThemeId",
      "TemperatureUnit"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_RIGHTEOUS_TIME_64",
          "file": "fonts/Righteous-Regular.ttf",
          "characterRegex": "[:0-9]"
        },
        {
          "type": "font",
          "name": "FONT_RIGHTEOUS_TIME_32",
          "file": "fonts/Righteous-Regular.ttf",
          "characterRegex": "[:0-9]"
        },
        {
          "type": "font",
          "name": "FONT_RIGHTEOUS_DATE_12",
          "file": "fonts/Righteous-Regular.ttf",
          "characterRegex": "[0-9A-Za-z ]"
        },
        {
          "type": "font",
          "name": "FONT_RIGHTEOUS_WEATHER_12",
          "file": "fonts/Righteous-Regular.ttf",
          "characterRegex": "[0-9A-Za-z :,.°]"
        }
      ]
    }
  }
}